{
  "name": "buy-or-rent",
  "version": "2.0.0",
  "private": true,
  "description": "A transparent, modern buy-versus-rent decision calculator.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
